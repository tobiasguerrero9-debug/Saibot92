    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "postcss": "^8.5.23",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "pngjs": "^7.0.0",
    "vite": "^8.1.1"
  },
  "engines": {
    "node": "22.x"
  }
