# Copy to server/augustus/.env.local; never put agent secrets in VITE_* or chat.
TOKEN_CHAIN_ID=4663
TOKEN_CONTRACT_ADDRESS=0x7673a00106c99d1e00b85496f9f495076873b654
TOKEN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
MIN_HOLDER_BALANCE=1
AUGUSTUS_UI_ORIGIN=http://127.0.0.1:5175
# Public funded TESTNET master account, not the agent address:
HYPERLIQUID_TESTNET_MASTER_ADDRESS=
# TESTNET delegated agent only. Never the master/private wallet key:
HYPERLIQUID_TESTNET_AGENT_PRIVATE_KEY=
# Keep false until holder/auth/risk checks and the approved tiny test are ready.
AUGUSTUS_ENABLE_TESTNET_EXECUTION=false

HYPERLIQUID_NETWORK=testnet
# Eligibility override only. Never enabled in production; requires an already armed, risk-valid session.
AUGUSTUS_ALLOW_DEV_FORCE_ENTRY=false
